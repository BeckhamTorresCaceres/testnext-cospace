# ==============================================================================
# Variables de Entorno - CoSpace
# ==============================================================================

# Conexión a Base de Datos PostgreSQL en Supabase
# Puerto 6543: Conexión mediante PgBouncer (Transaction Pooler) para el runtime en Vercel/Node
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true

# Puerto 5432: Conexión directa por sesión (Exclusiva para Prisma Migrate y DB Seed)
DIRECT_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# Secretos criptográficos para tokens JWT (Generar con: openssl rand -base64 32)
JWT_ACCESS_SECRET=tu_clave_secreta_jwt_access_minimo_32_caracteres
JWT_REFRESH_SECRET=tu_clave_secreta_jwt_refresh_minimo_32_caracteres

# Tiempos de expiración de tokens
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Zona horaria operativa del Coworking (Reglas de negocio evaluadas en America/Bogota)
NEXT_PUBLIC_TIMEZONE=America/Bogota

# URL pública de la aplicación
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Configuración NextAuth / Auth.js (OAuth con Google)
AUTH_SECRET=tu_clave_secreta_para_authjs_minimo_32_caracteres
AUTH_GOOGLE_ID=tu_google_client_id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=tu_google_client_secret
